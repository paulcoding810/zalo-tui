{
  "name": "zalo-tui",
  "version": "0.1.0",
  "description": "A terminal client for Zalo personal accounts, built on zca-js",
  "private": true,
  "type": "module",
  "bin": {
    "zalo-tui": "./bin/zalo-tui.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "start": "tsx src/index.tsx",
    "build": "esbuild src/index.tsx --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/zalo-tui.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepack": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "zalo",
    "tui",
    "terminal",
    "chat",
    "ink"
  ],
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "image-size": "2.1.0",
    "ink": "^8.0.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "zca-js": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
